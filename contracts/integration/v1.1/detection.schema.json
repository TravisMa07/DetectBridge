{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:integration:1.1.0:detection",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.1.0"
    },
    "processing_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attribution": {
      "$ref": "urn:detectbridge:integration:1.1.0:common#/$defs/attribution"
    },
    "detection_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifest": {
      "$ref": "urn:detectbridge:integration:1.1.0:common#/$defs/manifest"
    },
    "rule": {
      "$ref": "urn:detectbridge:integration:1.1.0:common#/$defs/rule"
    }
  },
  "required": [
    "version",
    "processing_id",
    "event_id",
    "run_id",
    "attribution",
    "detection_id",
    "manifest",
    "rule"
  ],
  "additionalProperties": false
}
