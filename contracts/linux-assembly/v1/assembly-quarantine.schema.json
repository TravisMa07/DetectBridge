{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:assembly:1.0.0:quarantine",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "const": "quarantine"
    },
    "category": {
      "const": "invalid_assembly_input"
    },
    "input": {
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "partition": {
          "const": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "value_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "cluster_id",
        "topic_id",
        "topic",
        "partition",
        "offset",
        "value_sha256"
      ],
      "additionalProperties": false
    },
    "value_is_null": {
      "type": "boolean"
    },
    "value_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2097152
    }
  },
  "required": [
    "version",
    "id",
    "kind",
    "category",
    "input",
    "value_is_null",
    "value_size"
  ],
  "additionalProperties": false
}
