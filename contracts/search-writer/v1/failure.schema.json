{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:search-writer:1.0.0:failure",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "failure_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string"
        },
        "topic_id": {
          "type": "string"
        },
        "topic": {
          "enum": [
            "detectbridge.tagged-events.v1",
            "detectbridge.detections.v1",
            "detectbridge.processing-diagnostics.v1"
          ]
        },
        "partition": {
          "const": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cluster_id",
        "topic_id",
        "topic",
        "partition",
        "offset"
      ],
      "additionalProperties": false
    },
    "value_is_null": {
      "type": "boolean"
    },
    "value_size": {
      "type": "integer",
      "minimum": 0
    },
    "value_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "invalid_json",
            "schema_invalid",
            "identity_conflict",
            "document_rejected",
            "integration_schema_invalid",
            "unsupported_search_input",
            "evaluation_binding_mismatch",
            "event_attribution_mismatch",
            "processing_identity_mismatch",
            "match_count_mismatch",
            "match_identity_mismatch",
            "detection_identity_mismatch",
            "diagnostic_identity_mismatch",
            "search_key_mismatch",
            "integration_binding_mismatch"
          ]
        },
        "pointer": {
          "const": ""
        }
      },
      "required": [
        "category",
        "pointer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "failure_id",
    "input",
    "value_is_null",
    "value_size",
    "value_sha256",
    "diagnostic"
  ],
  "additionalProperties": false
}
