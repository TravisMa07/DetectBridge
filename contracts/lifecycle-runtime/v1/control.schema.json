{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:lifecycle-runtime:1.0.0:control",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "key_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "deployment_id": {
          "type": "string",
          "format": "uuid"
        },
        "authority_id": {
          "type": "string",
          "format": "uuid"
        },
        "proposal": {
          "$ref": "urn:detectbridge:lifecycle-runtime:1.0.0:common#/$defs/proposal"
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "previous_control_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registrations": {
          "type": "array",
          "items": {
            "$ref": "urn:detectbridge:lifecycle-runtime:1.0.0:common#/$defs/registration"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "deployment_id",
        "authority_id",
        "proposal",
        "proposal_sha256",
        "revision",
        "previous_control_sha256",
        "runtime_binding_sha256",
        "registrations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous_control_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_control_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "version",
    "key_sha256",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
