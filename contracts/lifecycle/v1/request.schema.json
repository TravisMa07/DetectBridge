{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:lifecycle:1.0.0:request",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "authority_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "import",
        "validate",
        "test",
        "stage",
        "prepare",
        "retire"
      ]
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "authority_id",
    "request_id",
    "operation",
    "bundle_sha256",
    "arguments"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "import"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "manifest_sha256",
              "plan_sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {
              "suite_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "suite_sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "stage"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {
              "command": {
                "type": "object",
                "properties": {
                  "version": {
                    "const": "1.0.0"
                  },
                  "authority_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "deployment_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "previous_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "action": {
                    "enum": [
                      "activate",
                      "rollback",
                      "membership"
                    ]
                  },
                  "bundle_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "compatibility_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "participants": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "properties": {
                        "worker_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "incarnation": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "worker_id",
                        "incarnation"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "version",
                  "authority_id",
                  "deployment_id",
                  "request_id",
                  "revision",
                  "previous_sha256",
                  "action",
                  "bundle_sha256",
                  "compatibility_sha256",
                  "participants"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "revision": {
                          "const": 1
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "previous_sha256": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "previous_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  }
                ]
              },
              "expected_preparation_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "command",
              "expected_preparation_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "retire"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
