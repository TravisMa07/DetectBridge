{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:archive:1.0.0:wire",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "partition": {
      "const": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "timestamp_type": {
      "enum": [
        "CreateTime",
        "LogAppendTime",
        "NoTimestampType"
      ]
    },
    "key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2796204,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2796204,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2796204,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 128
    },
    "category": {
      "enum": [
        "opaque",
        "source",
        "control",
        "derived",
        "invalid_source",
        "semantic_conflict"
      ]
    }
  },
  "required": [
    "version",
    "id",
    "topic",
    "topic_id",
    "partition",
    "offset",
    "timestamp",
    "timestamp_type",
    "key",
    "value",
    "headers",
    "dependencies",
    "category"
  ],
  "additionalProperties": false
}
