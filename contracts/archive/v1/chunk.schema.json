{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:archive:1.0.0:chunk",
  "type": "object",
  "properties": {
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "bytes": {
      "type": "string",
      "maxLength": 1398104,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "offset",
    "bytes"
  ],
  "additionalProperties": false
}
