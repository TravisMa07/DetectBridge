{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:lifecycle-runtime:1.0.0:artifact",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "key_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "deployment_id": {
          "type": "string",
          "format": "uuid"
        },
        "authority_id": {
          "type": "string",
          "format": "uuid"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "member": {
          "enum": [
            "manifest.json",
            "plan.json"
          ]
        },
        "member_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "member_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "chunk_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "chunk_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "runtime_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "deployment_id",
        "authority_id",
        "bundle_sha256",
        "member",
        "member_sha256",
        "member_bytes",
        "chunk_index",
        "chunk_count",
        "chunk_sha256",
        "data_base64",
        "runtime_binding_sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "member": {
                "const": "manifest.json"
              }
            }
          },
          "then": {
            "properties": {
              "member_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "chunk_index": {
                "const": 0
              },
              "chunk_count": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "version",
    "key_sha256",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
