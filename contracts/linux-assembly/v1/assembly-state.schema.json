{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:assembly:1.0.0:state",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assembler": {
      "type": "object"
    },
    "inbox": {
      "type": "array",
      "items": {
        "$ref": "urn:detectbridge:assembly:1.0.0:wire"
      },
      "maxItems": 64
    },
    "outbox": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "kind": {
            "enum": [
              "event",
              "manifest",
              "diagnostic",
              "receipt",
              "quarantine"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "document": {
            "type": "object"
          }
        },
        "required": [
          "sequence",
          "kind",
          "key",
          "document"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "next_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "received_offset": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9223372036854775807
    },
    "received_hash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    },
    "retired_sequence": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "version",
    "binding",
    "sha256",
    "assembler",
    "inbox",
    "outbox",
    "next_sequence",
    "received_offset",
    "received_hash",
    "retired_sequence"
  ],
  "additionalProperties": false
}
