{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:historical-replay:1.0.0:result",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "historical"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "enum": [
              "detectbridge.integration.input.v1",
              "detectbridge.tagged-events.v1",
              "detectbridge.detections.v1",
              "detectbridge.processing-diagnostics.v1",
              "detectbridge.integration.manifests.v1",
              "detectbridge.integration.preservation.v1"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "value_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "topic",
          "offset",
          "value_sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "native": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 3
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "tagged",
              "detection",
              "processing",
              "manifest",
              "preservation"
            ]
          },
          "value": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 106
    }
  },
  "required": [
    "version",
    "mode",
    "selection_sha256",
    "run_id",
    "unit_id",
    "label",
    "origin",
    "native",
    "outputs"
  ],
  "additionalProperties": false
}
