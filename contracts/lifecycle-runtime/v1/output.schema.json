{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:lifecycle-runtime:1.0.0:output",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "output_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "worker_id": {
      "type": "string",
      "format": "uuid"
    },
    "origin_incarnation": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibility_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "kind": {
      "enum": [
        "tagged",
        "detection",
        "processing",
        "manifest",
        "preservation",
        "receipt",
        "quarantine"
      ]
    },
    "inner_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "document": {
      "type": "object"
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "output_id",
    "deployment_id",
    "worker_id",
    "origin_incarnation",
    "revision",
    "command_sha256",
    "bundle_sha256",
    "plan_sha256",
    "compatibility_sha256",
    "sequence",
    "kind",
    "inner_key",
    "document",
    "document_sha256",
    "semantic_sha256"
  ],
  "additionalProperties": false
}
