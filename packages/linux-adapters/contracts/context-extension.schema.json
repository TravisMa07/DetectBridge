{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 32
    },
    "context": {
      "$ref": "urn:detectbridge:linux:1.0.0:context"
    }
  },
  "required": [
    "version",
    "source_sha256",
    "mapping_sha256",
    "findings",
    "context"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:linux:1.0.0:context-extension"
}
