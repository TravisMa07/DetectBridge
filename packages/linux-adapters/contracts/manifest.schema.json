{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "key": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "$ref": "urn:detectbridge:contracts:1.0.0:common#/$defs/source"
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "audit_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{1,9}$"
        },
        "audit_serial": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "run_id",
        "source",
        "host_id",
        "generation",
        "audit_timestamp",
        "audit_serial"
      ],
      "additionalProperties": false
    },
    "closure": {
      "enum": [
        "source_boundary",
        "timeout",
        "dataset_end",
        "resource_limit"
      ]
    },
    "assembler": {
      "const": "linux-audit/1.0.0"
    },
    "policy": {
      "const": "execution-evidence/1.0.0"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 32
    },
    "eligible": {
      "type": "boolean"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_provenance": {
      "type": "object",
      "properties": {
        "host_binding": {
          "$ref": "urn:detectbridge:linux:1.0.0:context#/properties/host_binding"
        },
        "source_generation": {
          "$ref": "urn:detectbridge:linux:1.0.0:context#/properties/source_generation"
        }
      },
      "required": [
        "host_binding",
        "source_generation"
      ],
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "cursor": {
                "$ref": "urn:detectbridge:contracts:1.0.0:common#/$defs/cursor"
              },
              "first_observed": {
                "$ref": "urn:detectbridge:contracts:1.0.0:common#/$defs/timestamp"
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "encoding": {
                "enum": [
                  "utf-8",
                  "base64"
                ]
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "retention": {
                "enum": [
                  "raw_inline",
                  "raw_reference"
                ]
              },
              "reference": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "object_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "byte_range": {
                    "type": "object",
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9223372036854775807
                      }
                    },
                    "required": [
                      "offset",
                      "length"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "uri",
                  "object_sha256"
                ],
                "additionalProperties": false
              },
              "context_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "record_id",
              "cursor",
              "first_observed",
              "raw_sha256",
              "evidence_sha256",
              "encoding",
              "media_type",
              "retention",
              "context_sha256"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "retention": {
                      "const": "raw_reference"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reference"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "reference"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "retention": {
                "const": "retained_raw"
              },
              "context_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "record_id",
              "evidence_sha256",
              "raw_sha256",
              "retention",
              "context_sha256"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "event_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "manifest_id",
    "key",
    "closure",
    "assembler",
    "policy",
    "findings",
    "eligible",
    "source_sha256",
    "mapping_sha256",
    "scope_provenance",
    "members"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:linux:1.0.0:manifest"
}
