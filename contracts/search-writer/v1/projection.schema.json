{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:search-writer:1.0.0:projection",
  "type": "object",
  "properties": {
    "pipeline_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "tagged",
        "detection",
        "processing",
        "writer_failure"
      ]
    },
    "input_sha256": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string"
    },
    "processing_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "semantic_event_sha256": {
      "type": "string"
    },
    "original_timestamp": {
      "type": "string"
    },
    "@timestamp": {
      "type": "string"
    },
    "time_projection_reason": {
      "type": "string"
    },
    "eligibility": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "rule_revision": {
      "type": "string"
    },
    "rule_title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "rule_set_sha256": {
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "p13-search/1.0.0"
    },
    "first_input": {
      "type": "object"
    },
    "source": {
      "type": "object"
    },
    "versions": {
      "type": "object"
    },
    "attribution": {
      "type": "object"
    },
    "manifest": {
      "type": "object"
    },
    "evidence_source": {
      "type": "object"
    },
    "time": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "event": {
      "type": "object"
    },
    "rule": {
      "type": "object"
    },
    "rule_set": {
      "type": "object"
    },
    "diagnostic": {
      "type": "object"
    },
    "tags": {
      "type": "array"
    },
    "matches": {
      "type": "array"
    },
    "record_ids": {
      "type": "array"
    },
    "evidence_hashes": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "source_findings": {
      "type": "array"
    },
    "rule_tags": {
      "type": "array"
    },
    "rule_count": {
      "type": "integer",
      "minimum": 0
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "ip": {
          "type": "array",
          "items": {
            "type": "string",
            "anyOf": [
              {
                "format": "ipv4"
              },
              {
                "format": "ipv6"
              }
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "command_line": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "entity_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "command_line": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "working_directory": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "mode",
    "kind",
    "pipeline_id",
    "input_sha256",
    "content_sha256",
    "first_input"
  ],
  "additionalProperties": false
}
