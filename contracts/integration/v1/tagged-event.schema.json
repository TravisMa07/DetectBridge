{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:integration:1.0.0:tagged-event",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "processing_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event": {
      "$ref": "urn:detectbridge:contracts:1.0.0:normalized-event"
    },
    "attribution": {
      "$ref": "urn:detectbridge:integration:1.0.0:common#/$defs/attribution"
    },
    "manifest": {
      "$ref": "urn:detectbridge:integration:1.0.0:common#/$defs/manifest"
    },
    "counts": {
      "$ref": "urn:detectbridge:integration:1.0.0:common#/$defs/counts"
    },
    "matches": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "detection_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "detection_id"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "coverage:matched",
          "coverage:unmatched",
          "coverage:inapplicable",
          "coverage:configuration_blocked",
          "coverage:quality_skipped",
          "coverage:evaluation_error",
          "quality:eligible",
          "quality:skipped",
          "quality:undetermined"
        ]
      }
    }
  },
  "required": [
    "version",
    "processing_id",
    "event",
    "attribution",
    "manifest",
    "counts",
    "matches",
    "tags"
  ],
  "additionalProperties": false
}
