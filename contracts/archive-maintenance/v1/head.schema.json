{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:archive-maintenance:1.0.0:head",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "managed_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "holds",
        "retirements"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "record_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "managed_id",
    "kind",
    "sequence",
    "record_sha256",
    "checksum_sha256"
  ],
  "additionalProperties": false
}
