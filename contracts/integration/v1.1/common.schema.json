{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:integration:1.1.0:common",
  "$defs": {
    "attribution": {
      "type": "object",
      "properties": {
        "pipeline": {
          "const": "p13-runtime/1.0.0"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_contract": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "const": "1.0.0"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "mapping_profile": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "processing": {
          "type": "object",
          "properties": {
            "parser": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "normalizer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mapping": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "parser",
            "normalizer",
            "mapping"
          ],
          "additionalProperties": false
        },
        "compiler": {
          "const": "detectbridge/2.0.0"
        },
        "evaluator": {
          "const": "detectbridge-java/2.0.0"
        },
        "mapping_version": {
          "const": "source-mappings/1.0.0"
        },
        "selector": {
          "const": "source-index/1.0.0"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enrichment": {
          "type": "object",
          "properties": {
            "id": {
              "const": "coverage-and-rule-metadata"
            },
            "version": {
              "const": "1.0.0"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "external_inputs": {
          "type": "array",
          "maxItems": 0
        },
        "source": {
          "$ref": "urn:detectbridge:contracts:1.0.0:common#/$defs/source"
        },
        "context_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "required": [
        "pipeline",
        "bundle_sha256",
        "source_contract",
        "mapping_profile",
        "processing",
        "compiler",
        "evaluator",
        "mapping_version",
        "selector",
        "mapping_sha256",
        "enrichment",
        "external_inputs",
        "source",
        "context_sha256"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "manifest_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "semantic_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "manifest_id",
            "sha256",
            "semantic_sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logsource": {
          "type": "object",
          "properties": {
            "product": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "service": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "provenance": {
          "$ref": "urn:detectbridge:detection:1.0.0:candidate-provenance"
        }
      },
      "required": [
        "id",
        "revision",
        "logsource",
        "provenance"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unmatched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "inapplicable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "configuration_blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "quality_skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evaluation_error": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "matched",
        "unmatched",
        "inapplicable",
        "configuration_blocked",
        "quality_skipped",
        "evaluation_error"
      ],
      "additionalProperties": false
    },
    "rule_set": {
      "type": "object",
      "properties": {
        "version": {
          "const": "bundle-bits/1.0.0"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bits": {
          "type": "string",
          "pattern": "^[0-9a-f]{25}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "bundle_sha256",
        "bits",
        "count",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
