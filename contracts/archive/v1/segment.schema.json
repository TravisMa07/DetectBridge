{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:archive:1.0.0:segment",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "codec": {
      "const": "gzip-ndjson/1.0.0"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "partition": {
      "const": 0
    },
    "first": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "previous": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 128
    },
    "payload": {
      "type": "object",
      "properties": {
        "compressed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compressed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "uncompressed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "compressed_sha256",
        "compressed_bytes",
        "uncompressed_sha256",
        "uncompressed_bytes",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "codec",
    "binding_sha256",
    "topic_id",
    "partition",
    "first",
    "next",
    "previous",
    "dependencies",
    "payload"
  ],
  "additionalProperties": false
}
