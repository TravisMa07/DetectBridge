{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:archive-maintenance:1.0.0:plan",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "managed_id": {
      "type": "string",
      "format": "uuid"
    },
    "archive_binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "segments",
        "import"
      ]
    },
    "cutoff_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "previous_retirement_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "holds_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "detectbridge.integration.input.v1",
              "detectbridge.tagged-events.v1",
              "detectbridge.detections.v1",
              "detectbridge.processing-diagnostics.v1",
              "detectbridge.integration.manifests.v1",
              "detectbridge.integration.preservation.v1",
              "detectbridge.integration.quarantine.v1",
              "detectbridge.integration.receipts.v1",
              "detectbridge.integration.writer-failures.v1"
            ]
          },
          "floor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "floor_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "next": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "head_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "topic",
          "floor",
          "floor_sha256",
          "next",
          "head_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 9,
      "maxItems": 9
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "detectbridge.integration.input.v1",
              "detectbridge.tagged-events.v1",
              "detectbridge.detections.v1",
              "detectbridge.processing-diagnostics.v1",
              "detectbridge.integration.manifests.v1",
              "detectbridge.integration.preservation.v1",
              "detectbridge.integration.quarantine.v1",
              "detectbridge.integration.receipts.v1",
              "detectbridge.integration.writer-failures.v1"
            ]
          },
          "next": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "topic",
          "next"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 9
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "detectbridge.integration.input.v1",
              "detectbridge.tagged-events.v1",
              "detectbridge.detections.v1",
              "detectbridge.processing-diagnostics.v1",
              "detectbridge.integration.manifests.v1",
              "detectbridge.integration.preservation.v1",
              "detectbridge.integration.quarantine.v1",
              "detectbridge.integration.receipts.v1",
              "detectbridge.integration.writer-failures.v1"
            ]
          },
          "segment": {
            "type": "object",
            "properties": {
              "version": {
                "const": "1.0.0"
              },
              "codec": {
                "const": "gzip-ndjson/1.0.0"
              },
              "binding_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "topic_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "partition": {
                "const": 0
              },
              "first": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "next": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "previous": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "maxItems": 128
              },
              "payload": {
                "type": "object",
                "properties": {
                  "compressed_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "compressed_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "uncompressed_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "uncompressed_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                },
                "required": [
                  "compressed_sha256",
                  "compressed_bytes",
                  "uncompressed_sha256",
                  "uncompressed_bytes",
                  "rows"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "codec",
              "binding_sha256",
              "topic_id",
              "partition",
              "first",
              "next",
              "previous",
              "dependencies",
              "payload"
            ],
            "additionalProperties": false
          },
          "segment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 0,
            "maxItems": 65536
          },
          "fingerprints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "identity_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "identity_sha256",
                "content_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          },
          "unknown_graph": {
            "type": "boolean"
          }
        },
        "required": [
          "topic",
          "segment",
          "segment_sha256",
          "identities",
          "fingerprints",
          "unknown_graph"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadata_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "metadata_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1
    }
  },
  "required": [
    "version",
    "managed_id",
    "archive_binding_sha256",
    "operation_id",
    "kind",
    "cutoff_ms",
    "reason",
    "previous_retirement_sha256",
    "holds_sha256",
    "catalog_sha256",
    "observed",
    "targets",
    "candidates",
    "imports"
  ],
  "additionalProperties": false
}
