{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:transport:1.0.0:publication",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destination_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rate": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "envelope_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "contract_version",
    "project",
    "pipeline_id",
    "run_id",
    "run_manifest_sha256",
    "destination_sha256",
    "bundle_sha256",
    "rate",
    "envelope_count"
  ],
  "additionalProperties": false
}
