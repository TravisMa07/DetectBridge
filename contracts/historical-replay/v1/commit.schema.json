{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:historical-replay:1.0.0:commit",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "index",
    "unit_id",
    "result_sha256",
    "result_bytes",
    "previous_sha256"
  ],
  "additionalProperties": false
}
