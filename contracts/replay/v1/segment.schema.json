{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:replay:1.0.0:segment",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "first_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    }
  },
  "required": [
    "contract_version",
    "manifest_sha256",
    "sha256",
    "first_sequence",
    "count",
    "bytes"
  ],
  "additionalProperties": false
}
