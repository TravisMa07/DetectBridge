{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:lifecycle-runtime:1.0.0:common",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "public-key": {
      "type": "string",
      "minLength": 4,
      "maxLength": 88,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "topic": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "partition": {
          "const": 0
        }
      },
      "required": [
        "name",
        "id",
        "partition"
      ],
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topic": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "partition": {
              "const": 0
            }
          },
          "required": [
            "name",
            "id",
            "partition"
          ],
          "additionalProperties": false
        },
        "next_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "cluster_id",
        "topic",
        "next_offset"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "authority_id": {
          "type": "string",
          "format": "uuid"
        },
        "deployment_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "previous_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "activate",
            "rollback",
            "membership"
          ]
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compatibility_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "worker_id": {
                "type": "string",
                "format": "uuid"
              },
              "incarnation": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "worker_id",
              "incarnation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "authority_id",
        "deployment_id",
        "request_id",
        "revision",
        "previous_sha256",
        "action",
        "bundle_sha256",
        "compatibility_sha256",
        "participants"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "registration": {
      "type": "object",
      "properties": {
        "worker_id": {
          "type": "string",
          "format": "uuid"
        },
        "incarnation": {
          "type": "string",
          "format": "uuid"
        },
        "public_key": {
          "type": "string",
          "minLength": 4,
          "maxLength": 88,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "input_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "input_topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "assigned_runs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "worker_id",
        "incarnation",
        "public_key",
        "input_topic",
        "input_topic_id",
        "assigned_runs"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compatibility_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_incarnation": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "revision",
        "command_sha256",
        "bundle_sha256",
        "plan_sha256",
        "compatibility_sha256",
        "origin_incarnation"
      ],
      "additionalProperties": false
    },
    "limits": {
      "const": {
        "store_bytes": 536870912,
        "reserve_bytes": 134217728,
        "bundles": 64,
        "controls": 4096,
        "incarnations": 256,
        "ack_observations": 262144,
        "ack_observation_bytes": 134217728,
        "chunk_bytes": 262144,
        "artifact_record_bytes": 524288,
        "control_record_bytes": 65536,
        "ack_record_bytes": 65536,
        "manifest_bytes": 65536,
        "plan_bytes": 4194304,
        "transfer_bytes": 8388608,
        "workers": 16,
        "runs_per_worker": 16,
        "assigned_runs": 256,
        "queue_count": 128,
        "queue_bytes": 33554432,
        "state_bytes": 170000384,
        "output_metadata_bytes": 65536,
        "output_body_bytes": 2097152,
        "controller_publications": 4096,
        "controller_recovery_headroom_bytes": 33554432,
        "journal_record_bytes": 65536,
        "control_rejections": 4096,
        "checkpoint_root_bytes": 1073741824,
        "checkpoint_reservation_bytes": 201326592,
        "retained_checkpoints": 3,
        "concurrent_checkpoints": 1
      }
    }
  }
}
