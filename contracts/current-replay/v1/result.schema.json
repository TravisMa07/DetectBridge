{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:detectbridge:current-replay:1.0.0:result",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "current"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin_selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "step": {
      "type": "object",
      "properties": {
        "at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "action": {
          "enum": [
            "input",
            "tick",
            "end"
          ]
        },
        "input": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "topic": {
                  "const": "detectbridge.integration.input.v1"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "value_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "topic",
                "offset",
                "value_sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "at_ms",
        "action",
        "input"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "tagged",
              "detection",
              "processing",
              "manifest",
              "preservation"
            ]
          },
          "value": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "mode",
    "run_id",
    "request_sha256",
    "origin_selection_sha256",
    "index",
    "transition_id",
    "step",
    "state",
    "outputs"
  ],
  "additionalProperties": false
}
